(document (TeXmacs "2.1.4")
  (style (tuple "beamer" "no-page-numbers" "doc" "chinese" "beamer/ccnu_beamer"))
  (body (document (hide-preamble (document ""))
          (screens (shown (document ""
                            ""
                            ""
                            (title-slide (document (concat (value "slide-logo") (value "slide-text")))
                              (document (with "color" "#006672" "华中师范大学定制版"))
                              (document "" (small (with "color" "#006672" "模板作者：三鲤网络")))
                              (with "color" "#006571" (large "服务机构：华中师范大学"))
                            ) ;title-slide
                            ""
                          ) ;document
                   ) ;shown
            (hidden (document (tit-slide (document ""))
                      (section-slide (document (concat (with "color" "#006e7b" "01墨板基础") (with "color" "#006e7b" ""))
                                     ) ;document
                      ) ;section-slide
                    ) ;document
            ) ;hidden
            (hidden (document (with "color" "#006e7b" (tit "页面尺寸与页面边白"))
                      ""
                      (with "color"
                        "#006e7b"
                        (document "页面尺寸常用的有16:9和4:3，使用场景略有不同："
                          (description (document (concat (item* "16:9") "用于视频会议")
                                         (concat (item* "4:3") "用于线下授课")
                                       ) ;document
                          ) ;description
                          "具体需要依据设备的屏幕尺寸做相关调整。"
                          ""
                          (concat "页面边白可以使用" (menu "Document" "Page") "菜单更改。")
                        ) ;document
                      ) ;with
                      ""
                    ) ;document
            ) ;hidden
            (hidden (document (tit (document "页面布局"))
                      ""
                      (with "color"
                        "#006e7b"
                        (document (with "par-columns"
                                    "2"
                                    (document "你正在使用的是书籍这种页面布局。将光标放在此处（在冒号后面）："
                                      (concat "然后点击"
                                        (menu "Focus" "Book" "Beamer")
                                        "就可以把页面布局切换为幻灯片，你也可以使用焦点工具栏切换页面布局："
                                      ) ;concat
                                      (image (tuple (raw-data ""
                                                    ) ;raw-data
                                               "png"
                                             ) ;tuple
                                        "1par"
                                        ""
                                        ""
                                        ""
                                      ) ;image
                                    ) ;document
                                  ) ;with
                          (concat "然后你就可以通过"
                            (menu "View" "Presentation mode")
                            "进入演讲模式，在演讲模式中，你可以通过右键菜单退出演示模式。"
                          ) ;concat
                          (folded (document (question (document "为什么这个欢迎新用户幻灯片要使用书籍这种页面布局？（按下PageDown键就可以显示答案）"
                                                      ) ;document
                                            ) ;question
                                  ) ;document
                            (document (answer* (document "因为书籍这种页面布局是撰写幻灯片的推荐页面布局。"
                                               ) ;document
                                      ) ;answer*
                            ) ;document
                          ) ;folded
                        ) ;document
                      ) ;with
                    ) ;document
            ) ;hidden
            (hidden (document (tit-slide (document "")) (section-slide (document "02墨板进阶")))
            ) ;hidden
            (hidden (document (tit (menu "Insert" "Fold" "Folded"))
                      "假设你已经退出了幻灯片模式，并切换回了书籍这种页面布局。"
                      "你也许会好奇，如何插入上一页幻灯片中的问题1这种结构。"
                      "本页幻灯片的标题就是答案，你现在就可以练习一下："
                      ""
                    ) ;document
            ) ;hidden
            (hidden (document (tit "如何调整幻灯片的顺序")
                      "只要点击焦点工具栏上最右边的两个按钮就可以（光标请放在冒号后面）："
                      ""
                      "在书籍这种页面布局中，可以至少可以在一屏中查看两页幻灯片。"
                      (concat "切换到"
                        (menu "全景")
                        "这种页面布局，你就可以预览更多幻灯片并调整它们的顺序。"
                      ) ;concat
                      (image (tuple (raw-data ""
                                    ) ;raw-data
                               "png"
                             ) ;tuple
                        "1par"
                        ""
                        ""
                        ""
                      ) ;image
                    ) ;document
            ) ;hidden
            (hidden (document ""
                      ""
                      ""
                      (title-slide "" (really-huge "开始愉快地使用墨板吧!") "" "")
                    ) ;document
            ) ;hidden
          ) ;screens
        ) ;document
  ) ;body
  (initial (collection (associate "font-base-size" "8")
             (associate "info-flag" "minimal")
             (associate "page-even" "57pt")
             (associate "page-height" "auto")
             (associate "page-medium" "beamer")
             (associate "page-odd" "57pt")
             (associate "page-right" "57pt")
             (associate "page-screen-margin" "false")
             (associate "page-type" "16:9")
             (associate "page-width" "auto")
             (associate "preamble" "false")
             (associate "stem-doc-id" "788EDDDC-105E-4740-8CD0-3F49F99BCC80")
             (associate "strong-color" "#11315d")
             (associate "title-bar-color" (macro "#006e7b"))
             (associate "title-color" (macro "white"))
             (associate "title-shadow-color" "#5bb4b2")
           ) ;collection
  ) ;initial
  (references (collection (associate "auto-1" (tuple "?" "3"))
                (associate "auto-2" (tuple "?" "4"))
                (associate "auto-3" (tuple "?" "4"))
                (associate "auto-4" (tuple "?" "6"))
                (associate "auto-5" (tuple "?" "7"))
              ) ;collection
  ) ;references
  (auxiliary (collection (associate "idx"
                           (document (tuple (tuple (with "font-family" (quote "ss") "文档")
                                              (with "font-family" (quote "ss") "页面")
                                            ) ;tuple
                                       (pageref "auto-1")
                                     ) ;tuple
                             (tuple (tuple (with "font-family" (quote "ss") "焦点")
                                      (with "font-family" (quote "ss") "书籍")
                                      (with "font-family" (quote "ss") "Beamer")
                                    ) ;tuple
                               (pageref "auto-2")
                             ) ;tuple
                             (tuple (tuple (with "font-family" (quote "ss") "查看")
                                      (with "font-family" (quote "ss") "演讲模式")
                                    ) ;tuple
                               (pageref "auto-3")
                             ) ;tuple
                             (tuple (tuple (with "font-family" (quote "ss") "插入")
                                      (with "font-family" (quote "ss") "折叠")
                                      (with "font-family" (quote "ss") "已折叠")
                                    ) ;tuple
                               (pageref "auto-4")
                             ) ;tuple
                             (tuple (tuple (with "font-family" (quote "ss") "全景")) (pageref "auto-5"))
                           ) ;document
                         ) ;associate
             ) ;collection
  ) ;auxiliary
) ;document
